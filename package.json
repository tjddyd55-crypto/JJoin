{
  "name": "jjoin",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:mobile": "pnpm --filter @jjoin/mobile start",
    "dev:api": "pnpm --filter @jjoin/api start:dev",
    "build": "pnpm -r --if-present run build",
    "build:mobile-deps": "pnpm --filter @jjoin/types build && pnpm --filter @jjoin/domain build && pnpm --filter @jjoin/validation build && pnpm --filter @jjoin/api-client build && pnpm --filter @jjoin/i18n build",
    "build:api": "pnpm --filter @jjoin/types build && pnpm --filter @jjoin/domain build && pnpm --filter @jjoin/validation build && pnpm prisma:generate && pnpm --filter @jjoin/api build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint \"apps/api/src/**/*.ts\" \"apps/mobile/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.{ts,tsx}\" --max-warnings 300",
    "mobile:doctor": "powershell -ExecutionPolicy Bypass -File scripts/mobile-dev-doctor.ps1",
    "mobile:metro:recover": "powershell -ExecutionPolicy Bypass -File scripts/mobile-metro-recover.ps1",
    "test": "pnpm -r --if-present run test",
    "prisma:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma",
    "prisma:validate": "pnpm exec prisma validate --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "pnpm exec prisma migrate deploy --schema=prisma/schema.prisma",
    "prisma:migrate:status": "pnpm exec prisma migrate status --schema=prisma/schema.prisma",
    "start:api:prod": "node apps/api/dist/main.js",
    "sync:public-golf-facilities": "pnpm exec tsx scripts/run-public-golf-facility-sync.ts",
    "sync:public-golf-facilities:force": "pnpm exec tsx scripts/run-public-golf-facility-sync.ts --force",
    "matching-deadline": "pnpm exec tsx scripts/run-matching-deadline.ts",
    "chat-purge": "pnpm exec tsx scripts/run-chat-purge.ts",
    "recurring-joins": "pnpm exec tsx scripts/run-recurring-joins.ts",
    "notification-delivery": "pnpm exec tsx scripts/run-notification-delivery.ts",
    "attendance-reminders": "pnpm exec tsx scripts/run-attendance-reminders.ts",
    "payment:dev-smoke": "pnpm exec tsx scripts/payment-dev-smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "prettier": "^3.4.2",
    "prisma": "^6.19.3",
    "proj4": "^2.21.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  }
}
