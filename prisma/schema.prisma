generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum SocialProvider {
  KAKAO
  NAVER
  GOOGLE
}

enum JoinStatus {
  DRAFT
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  SETTLING
  COMPLETED
  CANCELLED
}

enum JoinMethod {
  OPEN
  APPROVAL
}

enum ParticipationStatus {
  APPLIED
  APPROVED
  CONFIRMED
  COMPLETED
  NO_SHOW
  LEFT_EARLY
  CANCELLED
  DISPUTED
}

enum ParticipantRole {
  HOST
  PARTICIPANT
}

enum RewardStatus {
  NOT_ELIGIBLE
  HELD
  PENDING_CONFIRMATION
  PAID
  AUTO_PAID
  DISPUTED
  REFUNDED
}

enum CoinHoldStatus {
  OPEN
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
}

enum CoinTxType {
  ROOM_CREATION_FEE
  JOIN_REWARD_HOLD
  JOIN_REWARD_RELEASE
  JOIN_REWARD_TRANSFER
  JOIN_REWARD_REFUND
  ADMIN_ADJUSTMENT
}

enum CoinTxDirection {
  DEBIT
  CREDIT
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolution {
  PAY_PARTICIPANT
  REFUND_HOST
}

enum DisputeReasonType {
  LEFT_EARLY
  DISPUTED
}

enum MediaKind {
  AVATAR
  OTHER
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  IDENTITY_NOTICE
  LOCATION
  MARKETING
  AVATAR_SKIPPED
}

enum NotificationType {
  JOIN_APPLICATION_RECEIVED
  JOIN_APPLICATION_APPROVED
  JOIN_APPLICATION_REJECTED
  SETTLEMENT_CONFIRMATION_REQUIRED
  REWARD_PAID
  REWARD_AUTO_PAID
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  JOIN_CANCELLED
  JOIN_UPDATED
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum PushProviderKind {
  EXPO
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Opt-in "지금 조인 가능" — not the same as OS location permission.
enum PresenceVisibility {
  HIDDEN
  AVAILABLE
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  status         UserStatus     @default(ACTIVE)
  identityStatus IdentityStatus @default(UNVERIFIED) @map("identity_status")
  countryCode    String         @default("KR") @map("country_code") @db.Char(2)
  locale         String         @default("ko-KR")
  timezone       String         @default("Asia/Seoul")
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile               UserProfile?
  socialAccounts        SocialAccount[]
  identityVerifications IdentityVerification[]
  mediaAssets           MediaAsset[]
  sportProfiles         UserSportProfile[]
  hostedJoins           Join[]                 @relation("JoinHost")
  participations        JoinParticipant[]
  wallets               Wallet[]
  reportsFiled          Report[]               @relation("ReportReporter")
  disputesOpened        DisputeCase[]          @relation("DisputeOpenedBy")
  disputesResolvedAdmin DisputeCase[]          @relation("DisputeResolvedBy")
  presence              UserPresence?
  consents              UserConsent[]
  pushDevices           PushDevice[]
  notifications         AppNotification[]
  pushNotificationsEnabled Boolean @default(true) @map("push_notifications_enabled")
  venueRecents          UserVenueRecent[]
  venueFavorites        UserVenueFavorite[]

  @@map("users")
}

model PushDevice {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  provider   PushProviderKind @default(EXPO)
  pushToken  String          @map("push_token")
  platform   PushPlatform
  deviceId   String?         @map("device_id")
  active     Boolean         @default(true)
  lastSeenAt DateTime        @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushToken])
  @@index([userId, active])
  @@map("push_devices")
}

/// In-app + push notification record. Retention: POLICY_TBD (no delete cron in MVP).
model AppNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  eventKey  String           @unique @map("event_key")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationOutbox {
  id             String                   @id @default(uuid()) @db.Uuid
  notificationId String                   @unique @map("notification_id") @db.Uuid
  status         NotificationOutboxStatus @default(PENDING)
  attemptCount   Int                      @default(0) @map("attempt_count")
  lastError      String?                  @map("last_error")
  nextAttemptAt  DateTime                 @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt         DateTime?                @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model UserConsent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  agreed    Boolean     @default(true)
  agreedAt  DateTime    @default(now()) @map("agreed_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@map("user_consents")
}

/// Current presence only (MVP: no location history table).
/// Public APIs must never expose actual latitude/longitude.
model UserPresence {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  visibility      PresenceVisibility @default(HIDDEN)
  availableUntil  DateTime?          @map("available_until") @db.Timestamptz(6)
  /// Actual coordinates — server-only; never in PublicNearbyUserDto
  latitude        Decimal            @db.Decimal(10, 7)
  longitude       Decimal            @db.Decimal(10, 7)
  accuracyMeters  Float?             @map("accuracy_meters")
  lastLocationAt  DateTime           @map("last_location_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, availableUntil])
  @@index([lastLocationAt])
  @@map("user_presences")
}

model UserProfile {
  userId        String    @id @map("user_id") @db.Uuid
  nickname      String    @unique
  avatarAssetId String?   @map("avatar_asset_id") @db.Uuid
  gender        String?
  ageBand       String?   @map("age_band")
  regionCode    String?   @map("region_code")
  regionLabel   String?   @map("region_label")
  bio           String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset? @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model SocialAccount {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  provider        SocialProvider
  providerSubject String         @map("provider_subject")
  providerEmail   String?        @map("provider_email")
  linkedAt        DateTime       @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("social_accounts")
}

model IdentityVerification {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  provider               String
  providerVerificationId String?        @map("provider_verification_id")
  status                 IdentityStatus @default(PENDING)
  ciHash                 String?        @map("ci_hash")
  verifiedAt             DateTime?      @map("verified_at") @db.Timestamptz(6)
  /// Sensitive operational fields — never expose via public profile APIs
  verifiedNameMasked     String?        @map("verified_name_masked")
  birthDate              DateTime?      @map("birth_date") @db.Date
  phoneEncrypted         String?        @map("phone_encrypted")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("identity_verifications")
}

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  kind        MediaKind @default(AVATAR)
  storageKey  String    @map("storage_key")
  mimeType    String?   @map("mime_type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  profiles UserProfile[] @relation("ProfileAvatar")

  @@index([ownerUserId])
  @@map("media_assets")
}

model Sport {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameKey   String   @map("name_i18n_key")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rule          SportRule?
  venues        Venue[]
  joins         Join[]
  sportProfiles UserSportProfile[]

  @@map("sports")
}

model SportRule {
  sportId            String   @id @map("sport_id") @db.Uuid
  durationStrategy   String   @map("duration_strategy")
  durationParamJson  Json     @map("duration_param_json")
  defaultJoinMethod  JoinMethod @default(OPEN) @map("default_join_method")
  metadata           Json?
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@map("sport_rules")
}

model UserSportProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sportId    String   @map("sport_id") @db.Uuid
  skillLevel String   @map("skill_level")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
  @@map("user_sport_profiles")
}

model Venue {
  id               String   @id @default(uuid()) @db.Uuid
  sportId          String   @map("sport_id") @db.Uuid
  provider         String
  providerPlaceId  String   @map("provider_place_id")
  /// Optional link to nationwide GolfFacility master (LOCALDATA activation only).
  golfFacilityId   String?  @unique @map("golf_facility_id") @db.Uuid
  name             String
  address          String?
  roadAddress      String?  @map("road_address")
  latitude         Decimal  @db.Decimal(10, 7)
  longitude        Decimal  @db.Decimal(10, 7)
  phone            String?
  countryCode      String   @default("KR") @map("country_code") @db.Char(2)
  region           String?
  timezone         String?
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport         Sport          @relation(fields: [sportId], references: [id])
  golfFacility  GolfFacility?  @relation(fields: [golfFacilityId], references: [id], onDelete: SetNull)
  joins         Join[]
  userRecents   UserVenueRecent[]
  userFavorites UserVenueFavorite[]

  @@unique([provider, providerPlaceId])
  @@index([sportId, latitude, longitude])
  @@map("venues")
}

/// User's recently used venues for Join Create (updated on successful join create only).
model UserVenueRecent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("user_venue_recents")
}

/// User bookmarked venues for Join Create picker.
model UserVenueFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_venue_favorites")
}

model Join {
  id                      String     @id @default(uuid()) @db.Uuid
  sportId                 String     @map("sport_id") @db.Uuid
  venueId                 String     @map("venue_id") @db.Uuid
  hostUserId              String     @map("host_user_id") @db.Uuid
  title                   String?
  description             String?
  status                  JoinStatus @default(DRAFT)
  joinMethod              JoinMethod @default(OPEN) @map("join_method")
  startAt                 DateTime   @map("start_at") @db.Timestamptz(6)
  scheduledEndAt          DateTime   @map("scheduled_end_at") @db.Timestamptz(6)
  plannedPlayerCount      Int        @map("planned_player_count")
  confirmedPlayerCount    Int        @default(1) @map("confirmed_player_count")
  rewardPerParticipant    Decimal    @map("reward_per_participant") @db.Decimal(18, 4)
  coinAssetId             String     @map("coin_asset_id") @db.Uuid
  roomCreationFeeAmount   Decimal    @map("room_creation_fee_amount") @db.Decimal(18, 4)
  rewardHoldTotalAmount   Decimal    @map("reward_hold_total_amount") @db.Decimal(18, 4)
  costShareType           String?    @map("cost_share_type")
  countryCode             String     @default("KR") @map("country_code") @db.Char(2)
  timezone                String     @default("Asia/Seoul")
  confirmedAt             DateTime?  @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt             DateTime?  @map("cancelled_at") @db.Timestamptz(6)
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport          Sport              @relation(fields: [sportId], references: [id])
  venue          Venue              @relation(fields: [venueId], references: [id])
  host           User               @relation("JoinHost", fields: [hostUserId], references: [id])
  coinAsset      CoinAsset          @relation(fields: [coinAssetId], references: [id])
  requirements   JoinRequirement[]
  options        JoinOption[]
  participants   JoinParticipant[]
  holds          CoinHold[]
  reports        Report[]
  disputes       DisputeCase[]

  @@index([venueId, startAt])
  @@index([status, startAt])
  @@index([hostUserId, startAt])
  @@index([sportId, startAt])
  @@map("joins")
}

model JoinRequirement {
  id              String  @id @default(uuid()) @db.Uuid
  joinId          String  @map("join_id") @db.Uuid
  requirementType String  @map("requirement_type")
  operator        String
  valueJson       Json    @map("value_json")
  targetCount     Int?    @map("target_count")
  sortOrder       Int     @default(0) @map("sort_order")
  metadata        Json?

  join Join @relation(fields: [joinId], references: [id], onDelete: Cascade)

  @@index([joinId])
  @@map("join_requirements")
}

model JoinOption {
  id              String @id @default(uuid()) @db.Uuid
  joinId          String @map("join_id") @db.Uuid
  optionKey       String @map("option_key")
  optionValueJson Json   @map("option_value_json")

  join Join @relation(fields: [joinId], references: [id], onDelete: Cascade)

  @@unique([joinId, optionKey])
  @@map("join_options")
}

model JoinParticipant {
  id                   String              @id @default(uuid()) @db.Uuid
  joinId               String              @map("join_id") @db.Uuid
  userId               String              @map("user_id") @db.Uuid
  role                 ParticipantRole     @default(PARTICIPANT)
  participationStatus  ParticipationStatus @default(APPLIED) @map("participation_status")
  partySize            Int                 @default(1) @map("party_size")
  appliedAt            DateTime            @default(now()) @map("applied_at") @db.Timestamptz(6)
  approvedAt           DateTime?           @map("approved_at") @db.Timestamptz(6)
  confirmedAt          DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz(6)

  join       Join               @relation(fields: [joinId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlement RewardSettlement?
  reports    Report[]
  dispute    DisputeCase?

  @@unique([joinId, userId])
  @@index([userId])
  @@map("join_participants")
}

model RewardSettlement {
  id                   String       @id @default(uuid()) @db.Uuid
  joinId               String       @map("join_id") @db.Uuid
  joinParticipantId    String       @unique @map("join_participant_id") @db.Uuid
  coinAssetId          String       @map("coin_asset_id") @db.Uuid
  amount               Decimal      @db.Decimal(18, 4)
  rewardStatus         RewardStatus @default(HELD) @map("reward_status")
  holdId               String?      @map("hold_id") @db.Uuid
  settlementAvailableAt DateTime    @map("settlement_available_at") @db.Timestamptz(6)
  autoPayAt            DateTime     @map("auto_pay_at") @db.Timestamptz(6)
  heldAt               DateTime?    @map("held_at") @db.Timestamptz(6)
  paidAt               DateTime?    @map("paid_at") @db.Timestamptz(6)
  disputedAt           DateTime?    @map("disputed_at") @db.Timestamptz(6)
  refundedAt           DateTime?    @map("refunded_at") @db.Timestamptz(6)
  paidTxId             String?      @map("paid_tx_id") @db.Uuid
  idempotencyKey       String       @unique @map("idempotency_key")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  participant JoinParticipant  @relation(fields: [joinParticipantId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset        @relation(fields: [coinAssetId], references: [id])
  hold        CoinHold?        @relation(fields: [holdId], references: [id])
  paidTx      CoinTransaction? @relation(fields: [paidTxId], references: [id])
  dispute     DisputeCase?

  @@index([rewardStatus, autoPayAt])
  @@index([joinId])
  @@map("reward_settlements")
}

model CoinAsset {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameKey   String   @map("name_i18n_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallets      Wallet[]
  transactions CoinTransaction[]
  holds        CoinHold[]
  joins        Join[]
  settlements  RewardSettlement[]

  @@map("coin_assets")
}

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  coinAssetId      String   @map("coin_asset_id") @db.Uuid
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(18, 4)
  heldBalance      Decimal  @default(0) @map("held_balance") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAsset    CoinAsset         @relation(fields: [coinAssetId], references: [id])
  transactions CoinTransaction[]
  holds        CoinHold[]

  @@unique([userId, coinAssetId])
  @@map("wallets")
}

model CoinTransaction {
  id                   String           @id @default(uuid()) @db.Uuid
  walletId             String           @map("wallet_id") @db.Uuid
  coinAssetId          String           @map("coin_asset_id") @db.Uuid
  type                 CoinTxType
  direction            CoinTxDirection
  amount               Decimal          @db.Decimal(18, 4)
  balanceAfterAvailable Decimal         @map("balance_after_available") @db.Decimal(18, 4)
  balanceAfterHeld     Decimal          @map("balance_after_held") @db.Decimal(18, 4)
  refType              String?          @map("ref_type")
  refId                String?          @map("ref_id")
  idempotencyKey       String           @unique @map("idempotency_key")
  metadata             Json?
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset          @relation(fields: [coinAssetId], references: [id])
  settlements RewardSettlement[]

  @@index([walletId, createdAt])
  @@index([refType, refId])
  @@map("coin_transactions")
}

model CoinHold {
  id          String         @id @default(uuid()) @db.Uuid
  walletId    String         @map("wallet_id") @db.Uuid
  coinAssetId String         @map("coin_asset_id") @db.Uuid
  joinId      String?        @map("join_id") @db.Uuid
  amount      Decimal        @db.Decimal(18, 4)
  reason      String
  status      CoinHoldStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime?      @map("released_at") @db.Timestamptz(6)
  refundedAt  DateTime?      @map("refunded_at") @db.Timestamptz(6)

  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset          @relation(fields: [coinAssetId], references: [id])
  join        Join?              @relation(fields: [joinId], references: [id], onDelete: SetNull)
  settlements RewardSettlement[]

  @@index([walletId, status])
  @@index([joinId])
  @@map("coin_holds")
}

model Report {
  id                   String       @id @default(uuid()) @db.Uuid
  joinId               String       @map("join_id") @db.Uuid
  reporterUserId       String       @map("reporter_user_id") @db.Uuid
  subjectParticipantId String?      @map("subject_participant_id") @db.Uuid
  reasonCode           String       @map("reason_code")
  description          String?
  status               ReportStatus @default(OPEN)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  join               Join             @relation(fields: [joinId], references: [id], onDelete: Cascade)
  reporter           User             @relation("ReportReporter", fields: [reporterUserId], references: [id])
  subjectParticipant JoinParticipant? @relation(fields: [subjectParticipantId], references: [id], onDelete: SetNull)

  @@index([joinId, status])
  @@map("reports")
}

model DisputeCase {
  id                     String             @id @default(uuid()) @db.Uuid
  joinId                 String             @map("join_id") @db.Uuid
  joinParticipantId      String             @unique @map("join_participant_id") @db.Uuid
  settlementId           String             @unique @map("settlement_id") @db.Uuid
  openedByUserId         String             @map("opened_by_user_id") @db.Uuid
  reasonType             DisputeReasonType  @map("reason_type")
  hostStatement          String?            @map("host_statement")
  participantStatement   String?            @map("participant_statement")
  status                 DisputeStatus      @default(OPEN)
  resolution             DisputeResolution?
  resolvedByAdminUserId  String?            @map("resolved_by_admin_user_id") @db.Uuid
  adminNote              String?            @map("admin_note")
  openedAt               DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  underReviewAt          DateTime?          @map("under_review_at") @db.Timestamptz(6)
  participantStatementAt DateTime?          @map("participant_statement_at") @db.Timestamptz(6)
  resolvedAt             DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  join            Join              @relation(fields: [joinId], references: [id], onDelete: Cascade)
  participant     JoinParticipant   @relation(fields: [joinParticipantId], references: [id], onDelete: Cascade)
  settlement      RewardSettlement  @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  openedBy        User              @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id])
  resolvedByAdmin User?             @relation("DisputeResolvedBy", fields: [resolvedByAdminUserId], references: [id])

  @@index([status, openedAt])
  @@index([joinId])
  @@map("dispute_cases")
}

// ---------------------------------------------------------------------------
// GolfFacility — nationwide LOCALDATA golf practice master (design draft)
// Not applied via migration yet. Do not prisma db push / migrate deploy.
// Distinct from Venue (Kakao live activation for Join FK).
// ---------------------------------------------------------------------------

enum GolfFacilitySource {
  LOCALDATA_GOLF_PRACTICE_RANGE
  MANUAL
  OWNER_REGISTERED
  OTHER
}

enum GolfFacilityType {
  SCREEN_GOLF
  MIXED_GOLF_FACILITY
  PRACTICE_RANGE
  GOLF_ACADEMY
  INDOOR_PRACTICE
  OUTDOOR_PRACTICE
  OTHER_GOLF_FACILITY
  UNKNOWN
}

/// Facility sport classification (not the same as Sport catalog used by Join).
enum GolfFacilitySportType {
  GOLF
  PARK_GOLF
}

enum HasScreenGolf {
  YES
  NO
  UNKNOWN
}

enum ScreenStatus {
  CONFIRMED
  POSSIBLE
  UNKNOWN
  NON_SCREEN
}

enum ScreenConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum GolfFacilityBrand {
  GOLFZON
  SG_GOLF
  FRIENDS_SCREEN
  OTHER
  UNKNOWN
}

enum GolfFacilityPhoneStatus {
  PRESENT
  EMPTY
  INVALID
}

enum CoordinateSource {
  GOV_TM_CONVERTED
  NAVER_GEOCODED
  MANUAL
  UNKNOWN
}

enum CoordinateStatus {
  VALID
  INVALID
  MISSING
}

/// Nationwide golf facility master from LOCALDATA (and future owner/manual).
/// Screen availability is orthogonal to facilityType.
/// Soft-retain rows (isActive=false) so historical Join FKs remain valid later.
model GolfFacility {
  id String @id @default(uuid()) @db.Uuid

  source              GolfFacilitySource
  governmentSourceKey String             @map("government_source_key")
  managementNo        String             @map("management_no")
  localGovernmentCode String             @map("local_government_code")

  /// LOCALDATA original name — refreshed on sync.
  sourceName            String  @map("source_name")
  /// Service display name — protected from source overwrite after override.
  displayName           String  @map("display_name")
  normalizedName        String  @map("normalized_name")
  displayNameOverridden Boolean @default(false) @map("display_name_overridden")

  sourcePhone     String?                 @map("source_phone")
  phone           String?
  phoneStatus     GolfFacilityPhoneStatus @default(EMPTY) @map("phone_status")
  phoneOverridden Boolean                 @default(false) @map("phone_overridden")

  sourceRoadAddress     String? @map("source_road_address")
  roadAddress           String? @map("road_address")
  roadAddressOverridden Boolean @default(false) @map("road_address_overridden")

  sourceLotAddress     String? @map("source_lot_address")
  lotAddress           String? @map("lot_address")
  lotAddressOverridden Boolean @default(false) @map("lot_address_overridden")

  postalCode String? @map("postal_code")
  sido       String?
  sigungu    String?

  /// Original government TM (EPSG:5174) — retained for re-projection / audit.
  sourceTmX Decimal? @map("source_tm_x") @db.Decimal(18, 6)
  sourceTmY Decimal? @map("source_tm_y") @db.Decimal(18, 6)

  /// WGS84 — nullable; missing coords do not block import.
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  coordinateSource     CoordinateSource @default(UNKNOWN) @map("coordinate_source")
  coordinateStatus     CoordinateStatus @default(MISSING) @map("coordinate_status")
  coordinateVerifiedAt DateTime?        @map("coordinate_verified_at") @db.Timestamptz(6)

  facilityType GolfFacilityType      @map("facility_type")
  sportType    GolfFacilitySportType @default(GOLF) @map("sport_type")

  hasScreenGolf    HasScreenGolf    @default(UNKNOWN) @map("has_screen_golf")
  screenStatus     ScreenStatus     @default(UNKNOWN) @map("screen_status")
  screenConfidence ScreenConfidence @default(UNKNOWN) @map("screen_confidence")
  /// Audit / verification evidence tags (e.g. NAME_SCREEN_GOLF, BRAND_GOLFZON).
  screenEvidence   String[]         @default([]) @map("screen_evidence")
  screenGolfScore  Int?             @map("screen_golf_score")
  /// First-pass screen-name candidate flag (not the same as hasScreenGolf=NO).
  screenCandidate  Boolean          @default(false) @map("screen_candidate")

  /// MVP primary brand label; multi-system detail can expand later.
  primaryBrand GolfFacilityBrand @default(UNKNOWN) @map("primary_brand")
  screenBrands String[]          @default([]) @map("screen_brands")

  businessStatusCode String? @map("business_status_code")
  businessStatusName String? @map("business_status_name")
  detailStatusCode   String? @map("detail_status_code")
  detailStatusName   String? @map("detail_status_name")

  licenseDate DateTime? @map("license_date") @db.Date
  closureDate DateTime? @map("closure_date") @db.Date

  /// Government-data active (영업/정상). Do not hard-delete when false.
  isActive             Boolean @default(true) @map("is_active")
  /// JJOIN screen-join place eligibility (operator may override later).
  isScreenJoinEligible Boolean @default(false) @map("is_screen_join_eligible")

  exclusionReason String? @map("exclusion_reason")

  sourceLastModifiedAt DateTime? @map("source_last_modified_at") @db.Timestamptz(6)
  sourceDataUpdatedAt  DateTime? @map("source_data_updated_at") @db.Timestamptz(6)
  sourceSyncedAt       DateTime? @map("source_synced_at") @db.Timestamptz(6)

  /// Reserved for future FacilityVerification without blocking MVP.
  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// At most one LOCALDATA-backed Venue (via Venue.golfFacilityId unique).
  venue Venue?

  @@unique([source, governmentSourceKey])
  @@index([isActive, isScreenJoinEligible])
  @@index([isActive, isScreenJoinEligible, coordinateStatus])
  @@index([latitude, longitude])
  @@index([sido, sigungu])
  @@index([facilityType])
  @@index([screenStatus])
  @@index([hasScreenGolf])
  @@index([sportType])
  @@index([normalizedName])
  @@map("golf_facilities")
}
