/// Approved store ownership — one user may own many facilities.
model StoreOwnership {
  id             String               @id @default(uuid()) @db.Uuid
  userId         String               @map("user_id") @db.Uuid
  golfFacilityId String               @map("golf_facility_id") @db.Uuid
  venueId        String?              @map("venue_id") @db.Uuid
  requestId      String?              @unique @map("request_id") @db.Uuid
  status         StoreOwnershipStatus @default(ACTIVE)
  approvedAt     DateTime             @default(now()) @map("approved_at") @db.Timestamptz(6)
  revokedAt      DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  golfFacility GolfFacility           @relation(fields: [golfFacilityId], references: [id], onDelete: Cascade)
  venue        Venue?                 @relation(fields: [venueId], references: [id], onDelete: SetNull)
  request      StoreOwnershipRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  joins        Join[]

  @@unique([userId, golfFacilityId])
  @@index([userId, status])
  @@index([golfFacilityId, status])
  @@map("store_ownerships")
}

model JoinRequirement {
  id              String @id @default(uuid()) @db.Uuid
  joinId          String @map("join_id") @db.Uuid
  requirementType String @map("requirement_type")
  operator        String
  valueJson       Json   @map("value_json")
  targetCount     Int?   @map("target_count")
  sortOrder       Int    @default(0) @map("sort_order")
  metadata        Json?

  join Join @relation(fields: [joinId], references: [id], onDelete: Cascade)

  @@index([joinId])
  @@map("join_requirements")
}

model JoinOption {
  id              String @id @default(uuid()) @db.Uuid
  joinId          String @map("join_id") @db.Uuid
  optionKey       String @map("option_key")
  optionValueJson Json   @map("option_value_json")

  join Join @relation(fields: [joinId], references: [id], onDelete: Cascade)

  @@unique([joinId, optionKey])
  @@map("join_options")
}

model JoinParticipant {
  id                  String              @id @default(uuid()) @db.Uuid
  joinId              String              @map("join_id") @db.Uuid
  userId              String              @map("user_id") @db.Uuid
  role                ParticipantRole     @default(PARTICIPANT)
  participationStatus ParticipationStatus @default(APPLIED) @map("participation_status")
  /// Pre-game intent; orthogonal to COMPLETED/NO_SHOW game outcome.
  attendanceIntent    AttendanceIntent    @default(PENDING) @map("attendance_intent")
  attendanceIntentAt  DateTime?           @map("attendance_intent_at") @db.Timestamptz(6)
  partySize           Int                 @default(1) @map("party_size")
  appliedAt           DateTime            @default(now()) @map("applied_at") @db.Timestamptz(6)
  approvedAt          DateTime?           @map("approved_at") @db.Timestamptz(6)
  confirmedAt         DateTime?           @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt         DateTime?           @map("cancelled_at") @db.Timestamptz(6)

  join       Join              @relation(fields: [joinId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  settlement RewardSettlement?
  reports    Report[]
  dispute    DisputeCase?

  @@unique([joinId, userId])
  @@index([userId])
  @@index([joinId, attendanceIntent])
  @@map("join_participants")
}

/// One ephemeral chat room per Join (not a general messenger).
model JoinChatRoom {
  id         String            @id @default(uuid()) @db.Uuid
  joinId     String            @unique @map("join_id") @db.Uuid
  status     JoinChatRoomStatus @default(ACTIVE)
  closedAt   DateTime?         @map("closed_at") @db.Timestamptz(6)
  /// Soft-hide from UI after this instant; messages may still exist until purgeAfter.
  hideAfter  DateTime?         @map("hide_after") @db.Timestamptz(6)
  purgeAfter DateTime?         @map("purge_after") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  join     Join              @relation(fields: [joinId], references: [id], onDelete: Cascade)
  members  JoinChatMember[]
  messages JoinChatMessage[]

  @@index([status, purgeAfter])
  @@map("join_chat_rooms")
}

model JoinChatMember {
  id       String    @id @default(uuid()) @db.Uuid
  roomId   String    @map("room_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt   DateTime? @map("left_at") @db.Timestamptz(6)

  room JoinChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("join_chat_members")
}

model JoinChatMessage {
  id           String             @id @default(uuid()) @db.Uuid
  roomId       String             @map("room_id") @db.Uuid
  /// Null for SYSTEM messages.
  senderUserId String?            @map("sender_user_id") @db.Uuid
  kind         JoinChatMessageKind @default(TEXT)
  body         String
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  room   JoinChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@map("join_chat_messages")
}

/// Targeted re-invite to a specific Join (not reopen-prefill).
model JoinInvitation {
  id            String               @id @default(uuid()) @db.Uuid
  joinId        String               @map("join_id") @db.Uuid
  inviterUserId String               @map("inviter_user_id") @db.Uuid
  inviteeUserId String               @map("invitee_user_id") @db.Uuid
  status        JoinInvitationStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt   DateTime?            @map("responded_at") @db.Timestamptz(6)

  join    Join @relation(fields: [joinId], references: [id], onDelete: Cascade)
  inviter User @relation("JoinInvitationInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)
  invitee User @relation("JoinInvitationInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@unique([joinId, inviteeUserId])
  @@index([inviteeUserId, status, createdAt(sort: Desc)])
  @@index([inviterUserId, createdAt(sort: Desc)])
  @@map("join_invitations")
}

model RewardSettlement {
  id                    String       @id @default(uuid()) @db.Uuid
  joinId                String       @map("join_id") @db.Uuid
  joinParticipantId     String       @unique @map("join_participant_id") @db.Uuid
  coinAssetId           String       @map("coin_asset_id") @db.Uuid
  amount                Decimal      @db.Decimal(18, 4)
  rewardStatus          RewardStatus @default(HELD) @map("reward_status")
  holdId                String?      @map("hold_id") @db.Uuid
  settlementAvailableAt DateTime     @map("settlement_available_at") @db.Timestamptz(6)
  autoPayAt             DateTime     @map("auto_pay_at") @db.Timestamptz(6)
  heldAt                DateTime?    @map("held_at") @db.Timestamptz(6)
  paidAt                DateTime?    @map("paid_at") @db.Timestamptz(6)
  disputedAt            DateTime?    @map("disputed_at") @db.Timestamptz(6)
  refundedAt            DateTime?    @map("refunded_at") @db.Timestamptz(6)
  paidTxId              String?      @map("paid_tx_id") @db.Uuid
  idempotencyKey        String       @unique @map("idempotency_key")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  participant JoinParticipant  @relation(fields: [joinParticipantId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset        @relation(fields: [coinAssetId], references: [id])
  hold        CoinHold?        @relation(fields: [holdId], references: [id])
  paidTx      CoinTransaction? @relation(fields: [paidTxId], references: [id])
  dispute     DisputeCase?

  @@index([rewardStatus, autoPayAt])
  @@index([joinId])
  @@map("reward_settlements")
}

model CoinAsset {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameKey   String   @map("name_i18n_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  wallets      Wallet[]
  transactions CoinTransaction[]
  holds        CoinHold[]
  joins        Join[]
  settlements  RewardSettlement[]
  issuances    CoinIssuance[]

  @@map("coin_assets")
}

model Wallet {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  coinAssetId      String   @map("coin_asset_id") @db.Uuid
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(18, 4)
  heldBalance      Decimal  @default(0) @map("held_balance") @db.Decimal(18, 4)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  coinAsset    CoinAsset         @relation(fields: [coinAssetId], references: [id])
  transactions CoinTransaction[]
  holds        CoinHold[]

  @@unique([userId, coinAssetId])
  @@map("wallets")
}

model CoinTransaction {
  id                    String          @id @default(uuid()) @db.Uuid
  walletId              String          @map("wallet_id") @db.Uuid
  coinAssetId           String          @map("coin_asset_id") @db.Uuid
  type                  CoinTxType
  direction             CoinTxDirection
  amount                Decimal         @db.Decimal(18, 4)
  balanceAfterAvailable Decimal         @map("balance_after_available") @db.Decimal(18, 4)
  balanceAfterHeld      Decimal         @map("balance_after_held") @db.Decimal(18, 4)
  refType               String?         @map("ref_type")
  refId                 String?         @map("ref_id")
  idempotencyKey        String          @unique @map("idempotency_key")
  metadata              Json?
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset          @relation(fields: [coinAssetId], references: [id])
  settlements RewardSettlement[]
  issuance    CoinIssuance?

  @@index([walletId, createdAt])
  @@index([refType, refId])
  @@index([type, createdAt])
  @@map("coin_transactions")
}

/**
 * Audit / taxonomy for new Coin mints.
 * Balance SSOT remains CoinTransaction; this row never replaces the ledger.
 * PURCHASE / EVENT / ADMIN grant must create both rows in one transaction.
 */
model CoinIssuance {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  coinAssetId     String             @map("coin_asset_id") @db.Uuid
  amount          Decimal            @db.Decimal(18, 4)
  issuanceType    CoinIssuanceType   @map("issuance_type")
  reason          String?
  referenceType   String?            @map("reference_type")
  referenceId     String?            @map("reference_id")
  createdByUserId String?            @map("created_by_user_id") @db.Uuid
  ledgerTxId      String             @unique @map("ledger_tx_id") @db.Uuid
  idempotencyKey  String             @unique @map("idempotency_key")
  status          CoinIssuanceStatus @default(COMPLETED)
  metadata        Json?
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User            @relation("IssuanceRecipient", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("IssuanceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  coinAsset CoinAsset       @relation(fields: [coinAssetId], references: [id])
  ledgerTx  CoinTransaction @relation(fields: [ledgerTxId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([issuanceType, createdAt])
  @@index([userId, createdAt])
  @@index([referenceType, referenceId])
  @@map("coin_issuances")
}

model CoinHold {
  id          String         @id @default(uuid()) @db.Uuid
  walletId    String         @map("wallet_id") @db.Uuid
  coinAssetId String         @map("coin_asset_id") @db.Uuid
  joinId      String?        @map("join_id") @db.Uuid
  amount      Decimal        @db.Decimal(18, 4)
  reason      String
  status      CoinHoldStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt  DateTime?      @map("released_at") @db.Timestamptz(6)
  refundedAt  DateTime?      @map("refunded_at") @db.Timestamptz(6)

  wallet      Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  coinAsset   CoinAsset          @relation(fields: [coinAssetId], references: [id])
  join        Join?              @relation(fields: [joinId], references: [id], onDelete: SetNull)
  settlements RewardSettlement[]

  @@index([walletId, status])
  @@index([joinId])
  @@map("coin_holds")
}

model Report {
  id                   String       @id @default(uuid()) @db.Uuid
  joinId               String       @map("join_id") @db.Uuid
  reporterUserId       String       @map("reporter_user_id") @db.Uuid
  subjectParticipantId String?      @map("subject_participant_id") @db.Uuid
  reasonCode           String       @map("reason_code")
  description          String?
  status               ReportStatus @default(OPEN)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  join               Join             @relation(fields: [joinId], references: [id], onDelete: Cascade)
  reporter           User             @relation("ReportReporter", fields: [reporterUserId], references: [id])
  subjectParticipant JoinParticipant? @relation(fields: [subjectParticipantId], references: [id], onDelete: SetNull)

  @@index([joinId, status])
  @@map("reports")
}

model DisputeCase {
  id                     String             @id @default(uuid()) @db.Uuid
  joinId                 String             @map("join_id") @db.Uuid
  joinParticipantId      String             @unique @map("join_participant_id") @db.Uuid
  settlementId           String             @unique @map("settlement_id") @db.Uuid
  openedByUserId         String             @map("opened_by_user_id") @db.Uuid
  reasonType             DisputeReasonType  @map("reason_type")
  hostStatement          String?            @map("host_statement")
  participantStatement   String?            @map("participant_statement")
  status                 DisputeStatus      @default(OPEN)
  resolution             DisputeResolution?
  resolvedByAdminUserId  String?            @map("resolved_by_admin_user_id") @db.Uuid
  adminNote              String?            @map("admin_note")
  openedAt               DateTime           @default(now()) @map("opened_at") @db.Timestamptz(6)
  underReviewAt          DateTime?          @map("under_review_at") @db.Timestamptz(6)
  participantStatementAt DateTime?          @map("participant_statement_at") @db.Timestamptz(6)
  resolvedAt             DateTime?          @map("resolved_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  join            Join             @relation(fields: [joinId], references: [id], onDelete: Cascade)
  participant     JoinParticipant  @relation(fields: [joinParticipantId], references: [id], onDelete: Cascade)
  settlement      RewardSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  openedBy        User             @relation("DisputeOpenedBy", fields: [openedByUserId], references: [id])
  resolvedByAdmin User?            @relation("DisputeResolvedBy", fields: [resolvedByAdminUserId], references: [id])

  @@index([status, openedAt])
  @@index([joinId])
  @@map("dispute_cases")
}

// ---------------------------------------------------------------------------
// GolfFacility — nationwide LOCALDATA golf practice master
// Distinct from Venue (lazy activation for Join FK).
// ---------------------------------------------------------------------------

enum GolfFacilitySource {
  LOCALDATA_GOLF_PRACTICE_RANGE
  MANUAL
  OWNER_REGISTERED
  OTHER
}

enum GolfFacilityType {
  SCREEN_GOLF
  MIXED_GOLF_FACILITY
  PRACTICE_RANGE
  GOLF_ACADEMY
  INDOOR_PRACTICE
  OUTDOOR_PRACTICE
  OTHER_GOLF_FACILITY
  UNKNOWN
}

enum GolfFacilitySportType {
  GOLF
  PARK_GOLF
}

enum HasScreenGolf {
  YES
  NO
  UNKNOWN
}

enum ScreenStatus {
  CONFIRMED
  POSSIBLE
  UNKNOWN
  NON_SCREEN
}

enum ScreenConfidence {
  HIGH
  MEDIUM
  LOW
  UNKNOWN
}

enum GolfFacilityBrand {
  GOLFZON
  SG_GOLF
  FRIENDS_SCREEN
  OTHER
  UNKNOWN
}

enum GolfFacilityPhoneStatus {
  PRESENT
  EMPTY
  INVALID
}

enum CoordinateSource {
  GOV_TM_CONVERTED
  NAVER_GEOCODED
  MANUAL
  UNKNOWN
}

enum CoordinateStatus {
  VALID
  INVALID
  MISSING
}

model GolfFacility {
  id String @id @default(uuid()) @db.Uuid

  source              GolfFacilitySource
  governmentSourceKey String             @map("government_source_key")
  managementNo        String             @map("management_no")
  localGovernmentCode String             @map("local_government_code")

  sourceName            String  @map("source_name")
  displayName           String  @map("display_name")
  normalizedName        String  @map("normalized_name")
  displayNameOverridden Boolean @default(false) @map("display_name_overridden")

  sourcePhone     String?                 @map("source_phone")
  phone           String?
  phoneStatus     GolfFacilityPhoneStatus @default(EMPTY) @map("phone_status")
  phoneOverridden Boolean                 @default(false) @map("phone_overridden")

  sourceRoadAddress     String? @map("source_road_address")
  roadAddress           String? @map("road_address")
  roadAddressOverridden Boolean @default(false) @map("road_address_overridden")

  sourceLotAddress     String? @map("source_lot_address")
  lotAddress           String? @map("lot_address")
  lotAddressOverridden Boolean @default(false) @map("lot_address_overridden")

  postalCode String? @map("postal_code")
  sido       String?
  sigungu    String?

  sourceTmX Decimal? @map("source_tm_x") @db.Decimal(18, 6)
  sourceTmY Decimal? @map("source_tm_y") @db.Decimal(18, 6)

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  coordinateSource     CoordinateSource @default(UNKNOWN) @map("coordinate_source")
  coordinateStatus     CoordinateStatus @default(MISSING) @map("coordinate_status")
  coordinateVerifiedAt DateTime?        @map("coordinate_verified_at") @db.Timestamptz(6)

  facilityType GolfFacilityType      @map("facility_type")
  sportType    GolfFacilitySportType @default(GOLF) @map("sport_type")

  hasScreenGolf    HasScreenGolf    @default(UNKNOWN) @map("has_screen_golf")
  screenStatus     ScreenStatus     @default(UNKNOWN) @map("screen_status")
  screenConfidence ScreenConfidence @default(UNKNOWN) @map("screen_confidence")
  screenEvidence   String[]         @default([]) @map("screen_evidence")
  screenGolfScore  Int?             @map("screen_golf_score")
  screenCandidate  Boolean          @default(false) @map("screen_candidate")

  primaryBrand GolfFacilityBrand @default(UNKNOWN) @map("primary_brand")
  screenBrands String[]          @default([]) @map("screen_brands")

  businessStatusCode String? @map("business_status_code")
  businessStatusName String? @map("business_status_name")
  detailStatusCode   String? @map("detail_status_code")
  detailStatusName   String? @map("detail_status_name")

  licenseDate DateTime? @map("license_date") @db.Date
  closureDate DateTime? @map("closure_date") @db.Date

  isActive             Boolean @default(true) @map("is_active")
  /// Display/metadata only — never used to drop from master/map (Phase sync).
  isScreenJoinEligible Boolean @default(false) @map("is_screen_join_eligible")

  exclusionReason String? @map("exclusion_reason")

  sourceLastModifiedAt DateTime? @map("source_last_modified_at") @db.Timestamptz(6)
  sourceDataUpdatedAt  DateTime? @map("source_data_updated_at") @db.Timestamptz(6)
  sourceSyncedAt       DateTime? @map("source_synced_at") @db.Timestamptz(6)

  /// Last successful full sync that included this facility.
  lastSeenAt           DateTime? @map("last_seen_at") @db.Timestamptz(6)
  /// Consecutive successful syncs where this LOCALDATA key was absent (never hard-delete).
  consecutiveMissCount Int       @default(0) @map("consecutive_miss_count")
  /// Original LOCALDATA API item snapshot (additive).
  sourceRawJson        Json?     @map("source_raw_json")

  verifiedAt       DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedByUserId String?   @map("verified_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue                  Venue?
  storeOwnershipRequests StoreOwnershipRequest[]
  storeOwnerships        StoreOwnership[]
  follows                GolfFacilityFollow[]

  @@unique([source, governmentSourceKey])
  @@index([isActive, isScreenJoinEligible])
  @@index([isActive, isScreenJoinEligible, coordinateStatus])
  @@index([isActive, coordinateStatus])
  @@index([latitude, longitude])
  @@index([sido, sigungu])
  @@index([facilityType])
  @@index([screenStatus])
  @@index([hasScreenGolf])
  @@index([sportType])
  @@index([normalizedName])
  @@index([lastSeenAt])
  @@map("golf_facilities")
}

enum PublicGolfFacilitySyncRunStatus {
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
  ABORTED_GUARD
}

/// Audit log for nationwide LOCALDATA golf facility sync (15-day / 1·16 KST cron).
model PublicGolfFacilitySyncRun {
  id             String                          @id @default(uuid()) @db.Uuid
  status         PublicGolfFacilitySyncRunStatus
  source         String                          @default("LOCALDATA_GOLF_PRACTICE_RANGE")
  startedAt      DateTime                        @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime?                       @map("finished_at") @db.Timestamptz(6)
  fetchedPages   Int                             @default(0) @map("fetched_pages")
  fetchedCount   Int                             @default(0) @map("fetched_count")
  insertedCount  Int                             @default(0) @map("inserted_count")
  updatedCount   Int                             @default(0) @map("updated_count")
  unchangedCount Int                             @default(0) @map("unchanged_count")
  inactiveCount  Int                             @default(0) @map("inactive_count")
  geocodedCount  Int                             @default(0) @map("geocoded_count")
  failedCount    Int                             @default(0) @map("failed_count")
  errorSummary   String?                         @map("error_summary")
  meta           Json?
  createdAt      DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([startedAt])
  @@index([status, startedAt])
  @@map("public_golf_facility_sync_runs")
}
