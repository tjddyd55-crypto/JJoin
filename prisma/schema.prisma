generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum IdentityStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

enum SocialProvider {
  KAKAO
  NAVER
  GOOGLE
}

enum JoinStatus {
  DRAFT
  OPEN
  FULL
  CONFIRMED
  IN_PROGRESS
  SETTLING
  COMPLETED
  CANCELLED
}

enum JoinMethod {
  OPEN
  APPROVAL
}

/**
 * STANDARD = existing P2P join; STORE_MATCHING = store-owner recruitment join.
 */
enum JoinKind {
  STANDARD
  STORE_MATCHING
}

enum MatchingRewardTarget {
  FEMALE
  MALE
  ALL
}

enum StoreVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REVOKED
}

enum StoreOwnerRelation {
  REPRESENTATIVE
  OWNER
  MANAGER
  OTHER
}

enum StoreOwnershipStatus {
  ACTIVE
  REVOKED
}

enum ParticipationStatus {
  APPLIED
  APPROVED
  CONFIRMED
  COMPLETED
  NO_SHOW
  LEFT_EARLY
  CANCELLED
  DISPUTED
}

enum ParticipantRole {
  HOST
  PARTICIPANT
}

enum RewardStatus {
  NOT_ELIGIBLE
  HELD
  PENDING_CONFIRMATION
  PAID
  AUTO_PAID
  DISPUTED
  REFUNDED
}

enum CoinHoldStatus {
  OPEN
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
}

enum CoinTxType {
  ROOM_CREATION_FEE
  JOIN_REWARD_HOLD
  JOIN_REWARD_RELEASE
  JOIN_REWARD_TRANSFER
  JOIN_REWARD_REFUND
  ADMIN_ADJUSTMENT
  COIN_ISSUANCE
}

enum CoinIssuanceType {
  PURCHASE
  EVENT_REWARD
  SIGNUP_BONUS
  PROMOTION
  ADMIN_GRANT
  CUSTOMER_SUPPORT
  DEV_SEED
  OTHER
}

enum CoinIssuanceStatus {
  COMPLETED
}

enum CoinTxDirection {
  DEBIT
  CREDIT
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

enum DisputeResolution {
  PAY_PARTICIPANT
  REFUND_HOST
}

enum DisputeReasonType {
  LEFT_EARLY
  DISPUTED
}

enum MediaKind {
  AVATAR
  OTHER
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  IDENTITY_NOTICE
  LOCATION
  MARKETING
  AVATAR_SKIPPED
}

enum NotificationType {
  JOIN_APPLICATION_RECEIVED
  JOIN_APPLICATION_APPROVED
  JOIN_APPLICATION_REJECTED
  SETTLEMENT_CONFIRMATION_REQUIRED
  REWARD_PAID
  REWARD_AUTO_PAID
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  JOIN_CANCELLED
  JOIN_UPDATED
  /// Condition alert / followed-store share the same logical new-join channel (dedupe via eventKey).
  JOIN_ALERT_MATCH
  FOLLOWED_STORE_NEW_JOIN
  BOOKMARK_JOIN_CLOSING
  BOOKMARK_JOIN_SPOT_LEFT
  BOOKMARK_JOIN_UPDATED
  BOOKMARK_JOIN_CANCELLED
  URGENT_JOIN_OPENED
  JOIN_ATTENDANCE_CONFIRM_REQUIRED
  JOIN_INVITATION
  JOIN_CHAT_SYSTEM
  JOIN_STARTING_SOON
}

/// Pre-game attendance intent — distinct from ParticipationStatus COMPLETED/NO_SHOW.
enum AttendanceIntent {
  PENDING
  CONFIRMED
  DECLINED
}

enum JoinChatRoomStatus {
  ACTIVE
  READ_ONLY
  CLOSED
}

enum JoinChatMessageKind {
  TEXT
  SYSTEM
}

enum JoinInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum JoinAlertDateMode {
  TODAY
  THIS_WEEK
  SPECIFIC_DATE
}

enum JoinAlertTimeBand {
  ANY
  MORNING
  AFTERNOON
  EVENING
}

enum PushPlatform {
  ANDROID
  IOS
  WEB
}

enum PushProviderKind {
  EXPO
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
}

/// Opt-in "지금 조인 가능" — not the same as OS location permission.
enum PresenceVisibility {
  HIDDEN
  AVAILABLE
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  status         UserStatus     @default(ACTIVE)
  identityStatus IdentityStatus @default(UNVERIFIED) @map("identity_status")
  countryCode    String         @default("KR") @map("country_code") @db.Char(2)
  locale         String         @default("ko-KR")
  timezone       String         @default("Asia/Seoul")
  lastLoginAt    DateTime?      @map("last_login_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile                  UserProfile?
  socialAccounts           SocialAccount[]
  adminLoginCredential     AdminLoginCredential?
  identityVerifications    IdentityVerification[]
  mediaAssets              MediaAsset[]
  sportProfiles            UserSportProfile[]
  hostedJoins              Join[]                     @relation("JoinHost")
  participations           JoinParticipant[]
  wallets                  Wallet[]
  reportsFiled             Report[]                   @relation("ReportReporter")
  disputesOpened           DisputeCase[]              @relation("DisputeOpenedBy")
  disputesResolvedAdmin    DisputeCase[]              @relation("DisputeResolvedBy")
  presence                 UserPresence?
  consents                 UserConsent[]
  pushDevices              PushDevice[]
  notifications            AppNotification[]
  coinIssuancesReceived    CoinIssuance[]             @relation("IssuanceRecipient")
  coinIssuancesCreated     CoinIssuance[]             @relation("IssuanceCreatedBy")
  pushNotificationsEnabled Boolean                    @default(true) @map("push_notifications_enabled")
  venueRecents             UserVenueRecent[]
  venueFavorites           UserVenueFavorite[]
  joinRegionPreferences    UserJoinRegionPreference[]
  joinAlertSubscriptions   JoinAlertSubscription[]
  joinBookmarks            JoinBookmark[]
  golfFacilityFollows      GolfFacilityFollow[]
  storeOwnershipRequests   StoreOwnershipRequest[]    @relation("StoreOwnershipRequestApplicant")
  storeOwnerships          StoreOwnership[]
  storeRequestsReviewed    StoreOwnershipRequest[]    @relation("StoreOwnershipRequestReviewer")
  joinChatMemberships      JoinChatMember[]
  joinChatMessages         JoinChatMessage[]
  joinInvitationsSent      JoinInvitation[]           @relation("JoinInvitationInviter")
  joinInvitationsReceived  JoinInvitation[]           @relation("JoinInvitationInvitee")

  @@map("users")
}

model PushDevice {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  provider   PushProviderKind @default(EXPO)
  pushToken  String           @map("push_token")
  platform   PushPlatform
  deviceId   String?          @map("device_id")
  active     Boolean          @default(true)
  lastSeenAt DateTime         @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pushToken])
  @@index([userId, active])
  @@map("push_devices")
}

/// In-app + push notification record. Retention: POLICY_TBD (no delete cron in MVP).
model AppNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  eventKey  String           @unique @map("event_key")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox NotificationOutbox?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationOutbox {
  id             String                   @id @default(uuid()) @db.Uuid
  notificationId String                   @unique @map("notification_id") @db.Uuid
  status         NotificationOutboxStatus @default(PENDING)
  attemptCount   Int                      @default(0) @map("attempt_count")
  lastError      String?                  @map("last_error")
  nextAttemptAt  DateTime                 @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt         DateTime?                @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  notification AppNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model UserConsent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  agreed    Boolean     @default(true)
  agreedAt  DateTime    @default(now()) @map("agreed_at") @db.Timestamptz(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@map("user_consents")
}

/// Current presence only (MVP: no location history table).
/// Public APIs must never expose actual latitude/longitude.
model UserPresence {
  id             String             @id @default(uuid()) @db.Uuid
  userId         String             @unique @map("user_id") @db.Uuid
  visibility     PresenceVisibility @default(HIDDEN)
  availableUntil DateTime?          @map("available_until") @db.Timestamptz(6)
  /// Actual coordinates — server-only; never in PublicNearbyUserDto
  latitude       Decimal            @db.Decimal(10, 7)
  longitude      Decimal            @db.Decimal(10, 7)
  accuracyMeters Float?             @map("accuracy_meters")
  lastLocationAt DateTime           @map("last_location_at") @db.Timestamptz(6)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, availableUntil])
  @@index([lastLocationAt])
  @@map("user_presences")
}

model UserProfile {
  userId        String   @id @map("user_id") @db.Uuid
  nickname      String   @unique
  avatarAssetId String?  @map("avatar_asset_id") @db.Uuid
  gender        String?
  ageBand       String?  @map("age_band")
  regionCode    String?  @map("region_code")
  regionLabel   String?  @map("region_label")
  bio           String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarAsset MediaAsset? @relation("ProfileAvatar", fields: [avatarAssetId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model SocialAccount {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  provider        SocialProvider
  providerSubject String         @map("provider_subject")
  providerEmail   String?        @map("provider_email")
  linkedAt        DateTime       @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?      @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("social_accounts")
}

/// Env-bootstrapped admin login (Railway JJOIN_ADMIN_LOGIN_*). Password is hashed; never log plaintext.
model AdminLoginCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  loginId      String   @unique @map("login_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_login_credentials")
}

model IdentityVerification {
  id                     String         @id @default(uuid()) @db.Uuid
  userId                 String         @map("user_id") @db.Uuid
  provider               String
  providerVerificationId String?        @map("provider_verification_id")
  status                 IdentityStatus @default(PENDING)
  ciHash                 String?        @map("ci_hash")
  verifiedAt             DateTime?      @map("verified_at") @db.Timestamptz(6)
  /// Sensitive operational fields — never expose via public profile APIs
  verifiedNameMasked     String?        @map("verified_name_masked")
  birthDate              DateTime?      @map("birth_date") @db.Date
  phoneEncrypted         String?        @map("phone_encrypted")
  createdAt              DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("identity_verifications")
}

model MediaAsset {
  id          String    @id @default(uuid()) @db.Uuid
  ownerUserId String    @map("owner_user_id") @db.Uuid
  kind        MediaKind @default(AVATAR)
  storageKey  String    @map("storage_key")
  mimeType    String?   @map("mime_type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner    User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  profiles UserProfile[] @relation("ProfileAvatar")

  @@index([ownerUserId])
  @@map("media_assets")
}

model Sport {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  nameKey   String   @map("name_i18n_key")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rule          SportRule?
  venues        Venue[]
  joins         Join[]
  sportProfiles UserSportProfile[]

  @@map("sports")
}

model SportRule {
  sportId           String     @id @map("sport_id") @db.Uuid
  durationStrategy  String     @map("duration_strategy")
  durationParamJson Json       @map("duration_param_json")
  defaultJoinMethod JoinMethod @default(OPEN) @map("default_join_method")
  metadata          Json?
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@map("sport_rules")
}

model UserSportProfile {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  sportId    String   @map("sport_id") @db.Uuid
  skillLevel String   @map("skill_level")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport Sport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@unique([userId, sportId])
  @@map("user_sport_profiles")
}

model Venue {
  id              String   @id @default(uuid()) @db.Uuid
  sportId         String   @map("sport_id") @db.Uuid
  provider        String
  providerPlaceId String   @map("provider_place_id")
  /// Optional link to nationwide GolfFacility master (LOCALDATA activation only).
  golfFacilityId  String?  @unique @map("golf_facility_id") @db.Uuid
  name            String
  address         String?
  roadAddress     String?  @map("road_address")
  latitude        Decimal  @db.Decimal(10, 7)
  longitude       Decimal  @db.Decimal(10, 7)
  phone           String?
  countryCode     String   @default("KR") @map("country_code") @db.Char(2)
  region          String?
  timezone        String?
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport           Sport               @relation(fields: [sportId], references: [id])
  golfFacility    GolfFacility?       @relation(fields: [golfFacilityId], references: [id], onDelete: SetNull)
  joins           Join[]
  userRecents     UserVenueRecent[]
  userFavorites   UserVenueFavorite[]
  storeOwnerships StoreOwnership[]

  @@unique([provider, providerPlaceId])
  @@index([sportId, latitude, longitude])
  @@map("venues")
}

/// User's recently used venues for Join Create (updated on successful join create only).
model UserVenueRecent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId, lastUsedAt(sort: Desc)])
  @@map("user_venue_recents")
}

/// User bookmarked venues for Join Create picker.
model UserVenueFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("user_venue_favorites")
}

/// User preferred districts for Join Discovery quick picks.
model UserJoinRegionPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  sido      String
  sigungu   String
  label     String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sido, sigungu])
  @@index([userId, sortOrder])
  @@map("user_join_region_preferences")
}

model Join {
  id                    String                @id @default(uuid()) @db.Uuid
  sportId               String                @map("sport_id") @db.Uuid
  venueId               String                @map("venue_id") @db.Uuid
  hostUserId            String                @map("host_user_id") @db.Uuid
  title                 String?
  description           String?
  status                JoinStatus            @default(DRAFT)
  joinMethod            JoinMethod            @default(OPEN) @map("join_method")
  joinKind              JoinKind              @default(STANDARD) @map("join_kind")
  startAt               DateTime              @map("start_at") @db.Timestamptz(6)
  scheduledEndAt        DateTime              @map("scheduled_end_at") @db.Timestamptz(6)
  /// Recruitment deadline for STORE_MATCHING (must be < startAt).
  recruitClosesAt       DateTime?             @map("recruit_closes_at") @db.Timestamptz(6)
  plannedPlayerCount    Int                   @map("planned_player_count")
  /// Minimum confirmed players to proceed after deadline (STORE_MATCHING).
  minimumPlayers        Int?                  @map("minimum_players")
  targetMaleCount       Int?                  @map("target_male_count")
  targetFemaleCount     Int?                  @map("target_female_count")
  matchingRewardTarget  MatchingRewardTarget? @map("matching_reward_target")
  storeOwnershipId      String?               @map("store_ownership_id") @db.Uuid
  confirmedPlayerCount  Int                   @default(1) @map("confirmed_player_count")
  rewardPerParticipant  Decimal               @map("reward_per_participant") @db.Decimal(18, 4)
  coinAssetId           String                @map("coin_asset_id") @db.Uuid
  roomCreationFeeAmount Decimal               @map("room_creation_fee_amount") @db.Decimal(18, 4)
  rewardHoldTotalAmount Decimal               @map("reward_hold_total_amount") @db.Decimal(18, 4)
  costShareType         String?               @map("cost_share_type")
  countryCode           String                @default("KR") @map("country_code") @db.Char(2)
  timezone              String                @default("Asia/Seoul")
  confirmedAt           DateTime?             @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?             @map("cancelled_at") @db.Timestamptz(6)
  /// Public share slug for Landing `/j/{shareSlug}` (opaque, not UUID).
  shareSlug             String?               @unique @map("share_slug")
  /// Urgent vacancy recruitment (today, before start, seats remaining).
  isUrgent              Boolean               @default(false) @map("is_urgent")
  urgentUntil           DateTime?             @map("urgent_until") @db.Timestamptz(6)
  urgentSeats           Int?                  @map("urgent_seats")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  sport          Sport             @relation(fields: [sportId], references: [id])
  venue          Venue             @relation(fields: [venueId], references: [id])
  host           User              @relation("JoinHost", fields: [hostUserId], references: [id])
  coinAsset      CoinAsset         @relation(fields: [coinAssetId], references: [id])
  storeOwnership StoreOwnership?   @relation(fields: [storeOwnershipId], references: [id], onDelete: SetNull)
  requirements   JoinRequirement[]
  options        JoinOption[]
  participants   JoinParticipant[]
  holds          CoinHold[]
  reports        Report[]
  disputes       DisputeCase[]
  bookmarks      JoinBookmark[]
  chatRoom       JoinChatRoom?
  invitations    JoinInvitation[]

  @@index([venueId, startAt])
  @@index([status, startAt])
  @@index([hostUserId, startAt])
  @@index([sportId, startAt])
  @@index([joinKind, status, startAt])
  @@index([recruitClosesAt])
  @@index([isUrgent, startAt])
  @@map("joins")
}

/// User-defined discovery alert for new JOINABLE joins.
model JoinAlertSubscription {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  label         String?
  sido          String?
  sigungu       String?
  dateMode      JoinAlertDateMode @default(TODAY) @map("date_mode")
  specificDate  DateTime?         @map("specific_date") @db.Date
  timeBand      JoinAlertTimeBand @default(ANY) @map("time_band")
  joinableOnly  Boolean           @default(true) @map("joinable_only")
  enabled       Boolean           @default(true)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
  @@index([enabled, sido, sigungu])
  @@map("join_alert_subscriptions")
}

/// User ↔ Join interest (bookmark).
model JoinBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  joinId    String   @map("join_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  join Join @relation(fields: [joinId], references: [id], onDelete: Cascade)

  @@unique([userId, joinId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([joinId])
  @@map("join_bookmarks")
}

/// User ↔ GolfFacility follow.
model GolfFacilityFollow {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  golfFacilityId String   @map("golf_facility_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  golfFacility GolfFacility @relation(fields: [golfFacilityId], references: [id], onDelete: Cascade)

  @@unique([userId, golfFacilityId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([golfFacilityId])
  @@map("golf_facility_follows")
}

/// Applicant request to verify ownership of a GolfFacility (store).
model StoreOwnershipRequest {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @map("user_id") @db.Uuid
  golfFacilityId         String                  @map("golf_facility_id") @db.Uuid
  applicantName          String                  @map("applicant_name")
  applicantPhone         String                  @map("applicant_phone")
  relation               StoreOwnerRelation
  memo                   String?
  businessRegistrationNo String?                 @map("business_registration_no")
  status                 StoreVerificationStatus @default(PENDING)
  adminNote              String?                 @map("admin_note")
  rejectReason           String?                 @map("reject_reason")
  reviewedByAdminUserId  String?                 @map("reviewed_by_admin_user_id") @db.Uuid
  reviewedAt             DateTime?               @map("reviewed_at") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User            @relation("StoreOwnershipRequestApplicant", fields: [userId], references: [id], onDelete: Cascade)
  golfFacility GolfFacility    @relation(fields: [golfFacilityId], references: [id], onDelete: Cascade)
  reviewer     User?           @relation("StoreOwnershipRequestReviewer", fields: [reviewedByAdminUserId], references: [id], onDelete: SetNull)
  ownership    StoreOwnership?

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([golfFacilityId])
  @@map("store_ownership_requests")
