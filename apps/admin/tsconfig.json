{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@jjoin/types": ["../../packages/types/src/index.ts"],
      "@jjoin/api-client": ["../../packages/api-client/src/index.ts"]
    },
    "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src"]
}
