# Mobile env example — never commit real secrets

# Naver Maps Client ID (NCloud console) — keep out of git
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# LOCAL (Gate A / device QA) — ADB reverse to PC Nest on 3000
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# REMOTE (Railway) — set only in local .env when testing against production API
# EXPO_PUBLIC_API_URL=https://api-production-2d67e.up.railway.app
