# Mobile env example — never commit real secrets

# App variant (local Metro / prebuild). EAS sets this via eas.json profile env.
# development → 쪼인존 DEV / com.jjoin.app.dev / jjoindev
# production  → 쪼인존 / com.jjoin.app / jjoin
APP_VARIANT=development

# Kakao Map Android SDK — Native App Key (NOT REST API Key, NOT Login key)
# Production (APP_VARIANT=production)
EXPO_PUBLIC_KAKAO_MAP_NATIVE_APP_KEY=
# Development (APP_VARIANT=development) — separate Native App Key required
EXPO_PUBLIC_KAKAO_MAP_NATIVE_APP_KEY_DEV=

# Kakao Login — separate Native App Key from Map product conceptually;
# DEV uses *_DEV keys only (no fallback to Production).
EXPO_PUBLIC_KAKAO_LOGIN_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_LOGIN_NATIVE_APP_KEY_DEV=

# Naver Login — official Android/iOS SDK (NAVER Developers Application)
# Client ID + Client Secret (SDK initialize). Set in EAS env / local .env — never commit real values.
# EXPO_PUBLIC_* is inlined into the JS bundle; treat as runtime config, not a server-side secret.
EXPO_PUBLIC_NAVER_LOGIN_CLIENT_ID=
EXPO_PUBLIC_NAVER_LOGIN_CLIENT_SECRET=
# Optional iOS return URL scheme override (default: variant app scheme jjoindev / jjoin)
# EXPO_PUBLIC_NAVER_LOGIN_URL_SCHEME=
#
# Shell override guard (Windows PowerShell): stale session env vars override .env and cause
# Naver SDK "client info invalid". Before Metro / prebuild / run:android, check and clear:
#   Get-ChildItem Env:EXPO_PUBLIC_NAVER_LOGIN_CLIENT_ID
#   Get-ChildItem Env:EXPO_PUBLIC_NAVER_LOGIN_CLIENT_SECRET
#   Remove-Item Env:EXPO_PUBLIC_NAVER_LOGIN_CLIENT_ID -ErrorAction SilentlyContinue
#   Remove-Item Env:EXPO_PUBLIC_NAVER_LOGIN_CLIENT_SECRET -ErrorAction SilentlyContinue

# Google Sign-In — Web OAuth client ID (server audience must match Railway GOOGLE_OAUTH_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS project UUID (public) — overrides app.config DEFAULT_EAS_PROJECT_ID when set
# Linked project: @tjddyd55/jjoin
EXPO_PUBLIC_EAS_PROJECT_ID=

# Dev regression: force mock-sign-in instead of native OAuth in __DEV__
# EXPO_PUBLIC_USE_MOCK_SOCIAL_AUTH=true

# --- API URL ---
# Always prefer EXPO_PUBLIC_API_URL (overrides variant defaults).
#
# Development app (APP_VARIANT=development):
#   Set to shared Development API (NOT Production, NOT localhost by default).
# EXPO_PUBLIC_API_URL=https://<development-api-host>
# Optional alias when EXPO_PUBLIC_API_URL unset:
# EXPO_PUBLIC_DEVELOPMENT_API_URL=https://<development-api-host>
#
# Production / preview builds bake Production API via eas.json.
#
# Local Nest (exception only — migration/seed isolation):
# EXPO_PUBLIC_API_URL=http://127.0.0.1:3000
