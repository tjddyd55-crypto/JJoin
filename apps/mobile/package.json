{
  "name": "@jjoin/mobile",
  "main": "expo-router/entry",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "start:dev": "cross-env APP_VARIANT=development expo start --dev-client --localhost",
    "start:go": "expo start",
    "android": "expo run:android",
    "android:dev": "cross-env APP_VARIANT=development expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:dev": "cross-env APP_VARIANT=development expo prebuild -p android",
    "prebuild:prod": "cross-env APP_VARIANT=production expo prebuild -p android",
    "config:dev": "cross-env APP_VARIANT=development expo config --type public",
    "config:prod": "cross-env APP_VARIANT=production expo config --type public",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/features/join/attendance-intent-ui.test.ts src/config/app-variant-identity.test.ts",
    "lint": "echo \"mobile lint placeholder\"",
    "eas-build-post-install": "pnpm --dir ../.. run build:mobile-deps"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.14",
    "@jjoin/api-client": "workspace:*",
    "@jjoin/design-system": "workspace:*",
    "@jjoin/domain": "workspace:*",
    "@jjoin/i18n": "workspace:*",
    "@jjoin/types": "workspace:*",
    "@jjoin/validation": "workspace:*",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-seoul/kakao-login": "^6.0.4",
    "@react-native-seoul/naver-login": "^5.0.1",
    "expo": "~57.0.15",
    "expo-build-properties": "^57.0.13",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "^57.0.14",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "^57.0.12",
    "expo-notifications": "^57.0.13",
    "expo-router": "~57.0.15",
    "expo-secure-store": "^57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "jjoin-kakao-map": "file:./modules/jjoin-kakao-map",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "^2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.1.0",
    "typescript": "~5.7.3"
  }
}
