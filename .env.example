# Environment sample (never commit real secrets)
# Local SSOT: repository root `.env` only (do not also set DATABASE_URL in prisma/.env)

NODE_ENV=development
DATABASE_URL=postgresql://jjoin:jjoin@localhost:5432/jjoin?schema=public
# Railway injects PORT; local Nest uses API_PORT or 3000
API_PORT=3000
PORT=
JWT_SECRET=replace-me

# Provider slots
SOCIAL_AUTH_MODE=mock
# production real OAuth: hybrid (smoke personas + real tokens) or real (strict)
# SOCIAL_AUTH_MODE=hybrid
IDENTITY_PROVIDER=mock
# production identity contract: IDENTITY_PROVIDER=real (Phase N.1 — USER_ACTION_REQUIRED)
GOOGLE_OAUTH_CLIENT_ID=
VENUE_PROVIDER_MODE=mock
# production live venues: VENUE_PROVIDER_MODE=kakao + KAKAO_LOCAL_REST_API_KEY (server-only)
MEDIA_STORAGE_MODE=mock

# 공공데이터포털 — 생활_골프연습장업 조회 (진단/수집 전용)
# Put the real key only in gitignored root `.env.local` (never commit).
# Prefer Decoding key, or Encoding key as-is (script avoids double-encoding).
# DATA_GO_KR_SERVICE_KEY=

# Kakao Local (server-only — never EXPO_PUBLIC / never commit real values)
KAKAO_LOCAL_REST_API_KEY=
KAKAO_LOCAL_PAGE_SIZE=15
KAKAO_LOCAL_MAX_PAGES=3
KAKAO_LOCAL_FALLBACK_RADIUS_M=5000
KAKAO_LOCAL_TIMEOUT_MS=4000

# Kakao Map Android SDK — mobile Native App Key (NOT the REST key above)
# EXPO_PUBLIC_KAKAO_MAP_NATIVE_APP_KEY=

# Naver Login — server-only secret (never EXPO_PUBLIC / never mobile bundle)
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=

# Optional CORS allowlist (comma-separated). Empty = permissive reflect for early stage.
CORS_ORIGINS=

DEFAULT_COUNTRY=KR
DEFAULT_LOCALE=ko-KR
DEFAULT_TIMEZONE=Asia/Seoul
DEFAULT_CURRENCY=KRW

# Mobile (local ADB reverse — keep for device QA)
EXPO_PUBLIC_KAKAO_MAP_NATIVE_APP_KEY=
EXPO_PUBLIC_KAKAO_LOGIN_NATIVE_APP_KEY=
EXPO_PUBLIC_NAVER_LOGIN_CLIENT_ID=
EXPO_PUBLIC_NAVER_LOGIN_URL_SCHEME=jjoinnaverlogin
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Dev regression only — forces mock-sign-in in __DEV__
# EXPO_PUBLIC_USE_MOCK_SOCIAL_AUTH=true
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000

# Explore / Presence knobs
PRESENCE_STORE=prisma
# memory = local-only in-memory (never Production silent fallback)
PRESENCE_NEARBY_RADIUS_M=5000
PRESENCE_FRESHNESS_MINUTES=180
PRESENCE_NEARBY_LIMIT=40
# Server-only; never put in EXPO_PUBLIC or commit real values
PRESENCE_PRIVACY_SECRET=
# Cron / batch (names only — set on Railway, never commit values)
SETTLEMENT_CRON_SECRET=
NOTIFICATION_CRON_SECRET=
MATCHING_DEADLINE_HTTP_URL=
MATCHING_DEADLINE_BATCH_SIZE=

# Admin bootstrap (Railway API service — never commit values)
JJOIN_ADMIN_LOGIN_ID=
JJOIN_ADMIN_LOGIN_PASSWORD=

# Landing admin web (build-time API URL for /admin routes)
VITE_API_URL=
# TEST ONLY / POLICY_TBD — never treat as production fee/reward/KRW policy
COIN_POLICY_MODE=dev
# SOCIAL_AUTH_MODE=mock enables DEV persona funding on sign-in (ledger ADMIN_ADJUSTMENT)

